CAPI=2:

name : ::fileattrs:0

filesets:
  defines:
    files:
      - hasdefines : {define : {key1 : value1, key2 : value2}}
      - nodefines
  tags:
    tags : [fileset_tag]
    files:
      - hastags : {tags : [file_tag]}
      - inheritstags

targets:
  defines: {filesets : [defines]}
  tags: {filesets : [tags]}
